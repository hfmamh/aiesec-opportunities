# Copy to .env for local runs (do not commit .env). In GitHub Actions these
# are set as repo secrets instead (Settings -> Secrets and variables -> Actions).

# AIESEC's embedded public GraphQL key. See the comment at the top of
# aiesec_opportunities_table.py for how to re-capture it if it stops working.
AIESEC_API_KEY=

# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# From @BotFather. Which chat each source notifies is configured in the
# notification_channels table, not here.
TELEGRAM_BOT_TOKEN=
